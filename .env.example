# Copy to .env (make up does this automatically if .env is missing).
# Values here are for local development only.

# Host port Nginx publishes the platform on: http://localhost:${HTTP_PORT}
HTTP_PORT=8080

# Number of url-service replicas behind Nginx
URL_SERVICE_REPLICAS=2

# local | test | production   (test enables test-only routes used by API tests)
APP_ENV=local
LOG_LEVEL=info

# PostgreSQL (primary)
POSTGRES_PASSWORD=app_local_pw

# Nginx per-IP request limit; raise (e.g. 100000r/s) for load tests from one machine
NGINX_RATE_LIMIT=50r/s
